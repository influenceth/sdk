{
  "name": "@influenceth/sdk",
  "version": "2.9.0-rc.1",
  "description": "Influence SDK",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "module": "./build/index.js",
  "exports": {
    ".": {
      "import": "./build/index.js",
      "require": "./build/index.cjs"
    },
    "./images/manifests/images.v1.json": "./assets/images/manifests/images.v1.json",
    "./images/manifests/latest.json": "./assets/images/manifests/latest.json",
    "./prospecting/artifacts": "./src/contracts/prospecting/manifest.json",
    "./prospecting/contracts": "./src/contracts/prospecting/fieldwork.json",
    "./prospecting/verifiers": "./src/contracts/prospecting/verifiers.json",
    "./prospecting/proof-assets": "./src/contracts/prospecting/proof-assets.json",
    "./prospecting/claim-component": "./src/contracts/prospecting/claim-component.json",
    "./contracts/components": "./src/contracts/starknet_components.json",
    "./prospecting/gameplay-contracts": "./src/contracts/prospecting/gameplay.json",
    "./prospecting/gameplay-artifacts": "./src/contracts/prospecting/gameplay-manifest.json",
    "./contracts/abis": "./src/contracts/starknet_abis.json",
    "./contracts/systems": "./src/contracts/starknet_systems.json",
    "./contracts/events": "./src/contracts/starknet_events.json",
    "./contracts/types": "./src/contracts/starknet_types.json"
  },
  "browser": {
    "crypto": false
  },
  "files": [
    "build/index.js",
    "build/index.cjs",
    "assets/images/manifests/images.v1.json",
    "assets/images/manifests/latest.json",
    "src/contracts/prospecting/*.json",
    "src/contracts/starknet_components.json",
    "docs/prospecting.md",
    "src/contracts/starknet_abis.json",
    "src/contracts/starknet_systems.json",
    "src/contracts/starknet_events.json",
    "src/contracts/starknet_types.json"
  ],
  "scripts": {
    "build": "rollup --config ./rollup.config.js",
    "export-production-chains": "node ./src/scripts/exportProductionChains.js",
    "images:build": "node ./assets/images/tools/build-images.js --version v1 --clean",
    "lint": "eslint ./src",
    "prepublishOnly": "npm run build:release",
    "test": "NODE_ENV=test ./node_modules/.bin/mocha --recursive",
    "test:mission-bindings-build": "npm run build && node src/scripts/testStarterMissionBindingsBuild.mjs",
    "publish-sdk": "npm run build && npm publish --access public",
    "export-prospecting": "node ./src/scripts/exportProspectingArtifacts.js",
    "build:release": "NODE_ENV=production npm run build",
    "test:prospecting": "NODE_ENV=test mocha test/lib/prospecting.spec.js test/lib/prospectingBindings.spec.js test/lib/prospectingGame.spec.js test/lib/claimMining.spec.js test/lib/privateData.spec.js",
    "test:prospecting-build": "node src/scripts/testProspectingBuild.mjs",
    "export-prospecting-gameplay": "node ./src/scripts/exportProspectingGameplay.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Influenceth/sdk.git"
  },
  "author": "Unstoppable Games, Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Influenceth/sdk/issues"
  },
  "homepage": "https://github.com/Influenceth/sdk#readme",
  "browserslist": {
    "production": [
      "chrome 52",
      "opera 39",
      "edge 14",
      "firefox 52",
      "safari 10.1",
      "node 7",
      "ios 10.3",
      "samsung 6.2",
      "electron 1.3"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.19.3",
    "@babel/core": "7.28.5",
    "@babel/eslint-parser": "7.28.5",
    "@babel/plugin-syntax-import-assertions": "^7.20.0",
    "@babel/preset-env": "^7.19.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "almost-equal": "^1.1.0",
    "axios": "^1.3.3",
    "chai": "^4.3.6",
    "eslint": "^8.26.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-mocha": "^10.1.0",
    "eslint-plugin-n": "^15.4.0",
    "eslint-plugin-promise": "^6.1.1",
    "mocha": "^10.0.0",
    "rollup": "^4.62.2",
    "rollup-plugin-cleanup": "^3.2.1"
  },
  "dependencies": {
    "@influenceth/astro": "^0.2.6",
    "@libp2p/crypto": "5.2.0",
    "@zkpassport/poseidon2": "0.6.2",
    "buffer": "^6.0.3",
    "ethers": "^6.7.1",
    "garaga": "1.1.0",
    "mathjs": "^11.4.0",
    "starknet": "^10.8.0"
  }
}
